# Python virtual environment and bytecode
.venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# Raw data and split files (regenerated by src/data.py).
# Leading "/" anchors to the repo root, so PhishGuard_BERT/data/ is NOT ignored.
/data/

# Model weights and training artefacts (too large for git; regenerated by scripts)
/models/
/checkpoints/
/runs/
/wandb/

# Third-party reference repo (cloned locally, see README for commit hash)
/reference/

# Local databases, secrets, logs
*.db
.env
.env.*
*.log

# Hugging Face cache folders
.cache/
hf_cache/
huggingface/

# macOS / bundle archive (contents are committed unpacked)
.DS_Store
phishguard-ai-starter.zip

# NOTE: results/ is deliberately NOT ignored — its JSON and figures are evidence.

# Coverage data file (results/coverage.json holds the committed figure)
.coverage

# Local editor / Claude Code launch settings
.claude/
